// Issue #76: experimental source; independent clones only, no vanilla template patches.

// Preserve the vanilla carrier's native squad transport and retain one light weapon hardpoint.
// Validate light-weapon mounting and the no-accessory profile in the loadout UI.
clone "ModularVehicleTemplate" from="modular_vehicle_carrier" id="modular_vehicle.light_personnel_carrier" {
    clear "Slots"
    append "Slots" {
        set "SlotType" enum="ModularVehicleSlotType" "Light"
        set "TransformName" "chassis_mount_02"
        set "AllowsLightWeaponToBeIntegrated" #false
        set "UseRelativeAimAnchor" #false
    }
}

// Inherit the vanilla one-squad carrier's movement, cargo, damage and sound.
// carrier_light_static is a scenery prefab; mobile rig/animator compatibility is unknown.
clone "EntityTemplate" from="player_vehicle.modular_light_troop_carrier" id="player_vehicle.light_personnel_carrier" {
    set "Title" { set "m_DefaultTranslation" "Light Infantry Carrier (Utility)" }
    set "Description" { set "m_DefaultTranslation" "A stripped-down utility variant of the Light Infantry Carrier, with reduced armor, no accessory slots and one light weapon slot." }
    set "ModularVehicle" "modular_vehicle.light_personnel_carrier"
    // Donor is 125/110/90; nearest whole-number values at 90% are 113/99/81.
    set "Properties" {
        set "Armor" 113
        set "ArmorSide" 99
        set "ArmorBack" 81
    }
    clear "Prefabs"
    append "Prefabs" asset="carrier_light_static"
}

// Independent chassis item; the vanilla carrier remains unchanged at 220 supplies.
clone "VehicleItemTemplate" from="vehicle.chassis_carrier" id="vehicle.chassis_light_personnel_carrier" {
    set "EntityTemplate" "player_vehicle.light_personnel_carrier"
    set "DeployCosts" { set "m_Supplies" 0 }
    set "AccessorySlots" 0
    set "Rarity" 0
    set "MinCampaignProgress" 0
    set "BlackMarketMaxQuantity" 10
    set "TradeValue" 45
    set "ShortName" { set "m_DefaultTranslation" "Light Infantry Carrier (Utility)" }
    set "Description" { set "m_DefaultTranslation" "A one-squad Light Infantry Carrier with reduced armor, no accessory slots and one light weapon slot. Vehicle deployment costs 0 supplies; pilot costs are unchanged." }
}