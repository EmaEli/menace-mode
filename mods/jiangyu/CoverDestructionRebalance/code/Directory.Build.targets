<Project>
  <Target Name="JiangyuCheckSdkPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(JiangyuSdkDir)' == ''">
    <Error Text="JiangyuSdkDir is not set. Run jiangyu code sync or pass the SDK path to the build." />
  </Target>
  <ItemGroup>
    <Analyzer Include="$(JiangyuSdkDir)/Jiangyu.Sdk.Analyzers.dll" Condition="Exists('$(JiangyuSdkDir)/Jiangyu.Sdk.Analyzers.dll')" />
    <Reference Include="Jiangyu.Sdk">
      <HintPath>$(JiangyuSdkDir)/Jiangyu.Sdk.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderDir)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameAssembliesDir)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameAssembliesDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSirenix.Serialization">
      <HintPath>$(GameAssembliesDir)/Il2CppSirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(JiangyuDev)' != 'true'">
    <Compile Remove="**/*.Dev.cs" />
  </ItemGroup>
</Project>