<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
  <PropertyGroup Condition="'$(GameDir)' == '' AND '$(OS)' == 'Unix'">
    <GameDir>$(HOME)/.local/share/Steam/steamapps/common/Menace</GameDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameDir)' == '' AND '$(OS)' == 'Windows_NT'">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Menace</GameDir>
  </PropertyGroup>
  <PropertyGroup>
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == ''">$(GameDir)/MelonLoader/net6</MelonLoaderDir>
    <GameAssembliesDir Condition="'$(GameAssembliesDir)' == ''">$(GameDir)/MelonLoader/Il2CppAssemblies</GameAssembliesDir>
    <DebugType Condition="'$(JiangyuDev)' != 'true'">none</DebugType>
    <DebugSymbols Condition="'$(JiangyuDev)' != 'true'">false</DebugSymbols>
  </PropertyGroup>
</Project>