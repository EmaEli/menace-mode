// Half-cover destruction tiers, one tier lower than vanilla (Medium->Light,
// Heavy->Medium; gunslinger laser rifle Heavy->Light). Light/medium infantry
// mortar HE no longer destroys half cover. See ../PATCHES.md and the runtime guard in code/.

patch "SkillTemplate" "active.at_wardog_detonate" {
    set "EventHandlers" index=1 {
        set "DestroyHalfCover" enum="HalfCoverClass" "Light"
    }
}
