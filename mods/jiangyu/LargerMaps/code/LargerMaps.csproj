<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Jiangyu host for Larger Maps. The gameplay code is compiled from
    ../../../LargerMaps/src/LargerMaps; only the host binding (LargerMapsSystem.cs) lives here.
    Build settings and the Jiangyu.Sdk + game references come from Directory.Build.props / .targets.

    Note: `jiangyu compile` fingerprints only code/, so after editing the module
    sources run `jiangyu compile` with the clean flag.
  -->
  <PropertyGroup>
    <!-- Keep in step with jiangyu.json so the DLL metadata identifies the shipped build. -->
    <Version>2.2.0</Version>
    <AssemblyName>LargerMaps</AssemblyName>
    <RootNamespace>LargerMaps</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <SharedSourceDir>$(MSBuildThisFileDirectory)../../../LargerMaps/src/LargerMaps</SharedSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SharedSourceDir)/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- Direct Harmony (37 manual patches with __instance/__result/ref/__state) and
         native byte patching are outside the Context.Patches surface. -->
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MelonLoaderDir)/Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.TerrainModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      Settings companion (see ../../MenaceModSettings). Declared in jiangyu.json `depends`,
      so the loader has already loaded it into the default context when this DLL binds.
    -->
    <Reference Include="MenaceModSettings">
      <HintPath>../../MenaceModSettings/compiled/code/MenaceModSettings.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
