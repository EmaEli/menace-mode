<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.7.0</Version>
    <AssemblyName>AIPerformance</AssemblyName>
    <RootNamespace>AIPerformance</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <SharedSourceDir>$(MSBuildThisFileDirectory)../../../LargerMaps/src/LargerMaps</SharedSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Single ownership: LargerMaps.csproj explicitly excludes these sources. -->
    <Compile Include="$(SharedSourceDir)/SimplifiedCombatPlanning.cs" Link="SimplifiedCombatPlanning.cs" />
    <Compile Include="$(SharedSourceDir)/LocalTacticalRouting.cs" Link="LocalTacticalRouting.cs" />
    <Compile Include="$(SharedSourceDir)/KnownCombatSkillIds.cs" Link="KnownCombatSkillIds.cs" />
    <Reference Include="0Harmony" HintPath="$(MelonLoaderDir)/0Harmony.dll" Private="false" />
    <Reference Include="Il2CppSirenix.Serialization" HintPath="$(GameAssembliesDir)/Il2CppSirenix.Serialization.dll" Private="false" />
    <Reference Include="MenaceModSettings" HintPath="$(MenaceModSettingsPath)" Condition="'$(MenaceModSettingsPath)' != ''" Private="false" />
    <Reference Include="MenaceModSettings" HintPath="../../MenaceModSettings/compiled/code/MenaceModSettings.dll" Condition="'$(MenaceModSettingsPath)' == ''" Private="false" />
  </ItemGroup>
</Project>