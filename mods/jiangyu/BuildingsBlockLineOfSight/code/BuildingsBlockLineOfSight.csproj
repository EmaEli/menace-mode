<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Jiangyu host for BuildingsBlockLineOfSight. The gameplay code is shared with the legacy GameplaySuite
    modpack and compiled from ../../../GameplaySuite/src/BuildingsBlockLineOfSight (JIANGYU defined); only
    the host binding (BuildingsBlockLineOfSightSystem.cs) lives here. Build settings and the Jiangyu.Sdk +
    game references come from Directory.Build.props / .targets.

    Note: `jiangyu compile` fingerprints only code/, so after editing the shared
    sources run `jiangyu compile` with the clean flag.
  -->
  <PropertyGroup>
    <!-- Keep in step with jiangyu.json so the DLL metadata identifies the shipped build. -->
    <Version>0.2.2</Version>
    <AssemblyName>BuildingsBlockLineOfSight</AssemblyName>
    <RootNamespace>BuildingsBlockLineOfSight</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);JIANGYU</DefineConstants>
    <SuiteSourceDir>$(MSBuildThisFileDirectory)../../../GameplaySuite/src</SuiteSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SuiteSourceDir)/BuildingsBlockLineOfSight/*.cs" Exclude="$(SuiteSourceDir)/BuildingsBlockLineOfSight/Plugin.Modpack.cs;$(SuiteSourceDir)/BuildingsBlockLineOfSight/GlobalUsings.cs;$(SuiteSourceDir)/BuildingsBlockLineOfSight/NullableMetadata.cs" LinkBase="Module" />
    <Compile Include="$(SuiteSourceDir)/Shared/*.cs" LinkBase="Shared" />
    <Compile Include="$(SuiteSourceDir)/Shared/Jiangyu/*.cs" LinkBase="Shared/Jiangyu" />
  </ItemGroup>
  <ItemGroup>
    <!-- Direct Harmony: the module's manual prefix/postfix patches are outside the Context.Patches surface. -->
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- IMGUI, for the modules' DevConsole diagnostic panels (GUI/GUILayout). -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MelonLoaderDir)/Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      Settings companion (see ../../MenaceModSettings). Declared in jiangyu.json `depends`,
      so the loader has already loaded it into the default context when this DLL binds.
    -->
    <Reference Include="MenaceModSettings">
      <HintPath>../../MenaceModSettings/compiled/code/MenaceModSettings.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
