<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mod C# project. Build settings and the Jiangyu.Sdk + game references come
    from the Jiangyu-managed Directory.Build.props / Directory.Build.targets in
    this folder. Add NuGet packages or extra game-DLL references here as needed.
    The compiled DLL is picked up from code/bin/ by `jiangyu compile`.
  -->

  <PropertyGroup>
    <!-- Keep in step with jiangyu.json so the DLL metadata identifies the shipped build.
         AssemblyVersion stays fixed: consumer mods bind to "MenaceModSettings, Version=1.0.0.0"
         and the loader resolves by exact identity, so changing it breaks every installed consumer. -->
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
