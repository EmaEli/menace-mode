<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SquaddieFieldPromotions</AssemblyName>
    <Version>0.12.1</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <MenaceModSettingsPath Condition="'$(MenaceModSettingsPath)' == ''">../../MenaceModSettings/compiled/code/MenaceModSettings.dll</MenaceModSettingsPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MenaceModSettings">
      <HintPath>$(MenaceModSettingsPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- John/Jane voice bank (.sfpbundle) and runtime AudioClip handling. -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameAssembliesDir)/UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
