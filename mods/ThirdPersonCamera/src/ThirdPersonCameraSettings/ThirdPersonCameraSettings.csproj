<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ThirdPersonCameraSettings</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Reference Include="MelonLoader"><HintPath>$(MSBuildProjectDirectory)\..\..\refs\runtime\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MSBuildProjectDirectory)\..\..\refs\runtime\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Menace.ModpackLoader"><HintPath>$(GameDir)\Mods\Menace.ModpackLoader.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
