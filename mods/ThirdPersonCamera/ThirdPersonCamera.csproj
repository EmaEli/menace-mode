<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>MenaceThirdPersonCamera</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- By default compile against the supplied interop snapshot; build script selects live game refs when possible. -->
    <MenaceInteropDir Condition="'$(MenaceInteropDir)' == ''">$(MSBuildProjectDirectory)\refs\game</MenaceInteropDir>
    <MenaceRuntimeDir Condition="'$(MenaceRuntimeDir)' == ''">$(MSBuildProjectDirectory)/refs/runtime</MenaceRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\ThirdPersonCameraMod.cs" />
    <Reference Include="0Harmony"><HintPath>$(MenaceRuntimeDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(MenaceRuntimeDir)/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MenaceRuntimeDir)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(MenaceInteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(MenaceInteropDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(MenaceInteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(MenaceInteropDir)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
