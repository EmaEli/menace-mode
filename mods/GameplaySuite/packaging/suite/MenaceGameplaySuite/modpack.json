        "IsTargeted": true,
        "IsOverridingRanges": true,
        "MinRange": 1,
        "IdealRange": 1,
        "MaxRange": 1,
        "Title": "Resupply Infantry",
        "Description": "Fully refills the ammunition of an adjacent infantry unit. Player vehicles have one use by default; the Field Ammunition Supply module adds extra uses."
