  "version": "0.5.2",
  "author": "Luca / ChatGPT",
  "description": "Adds lethal 40 AP adjacent infantry assaults with symmetric CQB bonuses, suppression-aware defensive fire, garrison capture, AI use, and stance/suppression initiation restrictions.",
