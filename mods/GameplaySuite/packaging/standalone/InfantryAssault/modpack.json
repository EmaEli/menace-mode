        "IsLimitedUses": false,
        "Uses": 1,
        "IsActive": true,
        "IsTargeted": true,
        "TargetingCursor": 6,
        "TargetsAllowed": 1049600,
        "KeepSelectedIfStillUsable": false,
        "IsLineOfFireNeeded": false,
        "IsAttack": false,
        "IsAlwaysHitting": true,
        "CanHitAnotherTile": true,
        "IsIgnoringCover": true,
        "IsSilent": true,
        "UsabilityWhileContained": 1,
        "MarkAsActed": true,
        "IsHidden": false,
        "IsOverridingRanges": true,
        "MinRange": 1,
        "IdealRange": 1,
        "MaxRange": 1,
        "ApplyToEntityInsideStructure": true,
        "Title": "Assault",
        "Description": "Spend 40 AP to assault adjacent enemy infantry. Cannot be used while deployed/kneeling, Suppressed, or Pinned Down. The defender fires first if able; Pinned Down defenders react with half CQB bonuses, while Suppressed defenders cannot react. Surviving assaulters then fire; if the defender is destroyed, the assaulters occupy the target position.",
