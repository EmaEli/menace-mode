// Port of legacy CoverDestructionRebalance 0.3.1 (Modpack Loader) dynamic rule, frozen against
// MENACE 0.7.15 SkillTemplate data: Medium->Light, Heavy->Medium, active.laser_rifle_gunslinger
// Heavy->Light, light/medium infantry mortar HE -> None. None/Light handlers are unchanged.
// Each line notes the vanilla value. Regenerate if a game patch adds or changes attack handlers.
patch "SkillTemplate" "active.at_wardog_detonate" {
    // vanilla Medium (Attack handler)
    set "EventHandlers" index=1 {
        set "DestroyHalfCover" enum="HalfCoverClass" "Light"
    }
}

